# ===== SRSP Fitovinany — Backend : variables d'environnement =====
# Copier ce fichier vers .env puis adapter les valeurs :  cp .env.example .env

# --- Serveur ---
PORT=5000
NODE_ENV=development

# --- Base de données (MariaDB/MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=srsp_db

# --- Authentification JWT ---
JWT_SECRET=change_me_use_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Upload ---
UPLOAD_DIR=./src/uploads
MAX_FILE_SIZE=5242880

# --- Limitation de débit (HTTP 429) ---
# Désactivée par défaut en développement ; à activer en production (RATE_LIMIT_ENABLED=true)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW_MS=900000

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173