@startuml SRSP_Fitovinany_Architecture
' ============================================================================
' SRSP Fitovinany — Diagramme d'architecture (composants)
' ============================================================================

skinparam backgroundColor #FFFFFF

package "Frontend (React + Vite)" #E8F4F8 {
  [Pages (Dashboard, Dossiers, Rapports, Performance, Referentiel, ...)] as Pages
  [Composants (DossierForm, DepouillementChecklist, DocumentsPanel, DossierActions, ...)] as Components
  [Services (dossierService, documentService, rapportService, performanceService, ...)] as Services
  [AuthContext / useAuth] as Auth
  [Composants UI (Card, Modal, Table, Badge, ...)] as UI
}

package "Backend (Node.js + Express)" #FFF2CC {
  [Routes (dossierRoutes, documentRoutes, rapportRoutes, performanceRoutes, ...)] as Routes
  [Controllers (dossierController, documentController, rapportController, ...)] as Controllers
  [Services (dossierService, documentService, rapportService, performanceService, scopeService, ...)] as ServicesB
  [Models (dossierModel, documentModel, depouillementModel, ...)] as Models
  [Middlewares (authMiddleware, rbacMiddleware, scopeDossiersMiddleware, uploadMiddleware, ...)] as Middlewares
  [Config (db.js, env.js, multer.js, logger.js)] as Config
  [Utils (constants.js, httpError.js, ...)] as Utils
}

database "PostgreSQL 18" #DDEBF7 {
  [srsp_db (61 tables, ICU ci, Africa/Nairobi)] as PG
  [datediff() function] as Datediff
  [Migrations (REJETEE, notifications NULLS NOT DISTINCT)] as Migrations
}

folder "Systeme de fichiers" #E2EFDA {
  [uploads/ (fichiers UUID)] as Uploads
  [logs/ (api.out.log, api.err.log)] as Logs
}

Pages --> Components
Components --> Services
Services --> Auth
Auth --> API : HTTP REST (axios)

API --> Routes
Routes --> Middlewares
Middlewares --> Controllers
Controllers --> ServicesB
ServicesB --> Models
Models --> Config
Config --> PG
PG --> Datediff
PG --> Migrations

Frontend ..> Backend : WebSocket (Socket.io)
Backend ..> Frontend : Temps reel
Multer --> Uploads
Express --> PG

@enduml

@startuml SRSP_Fitovinany_Sequence_Marquage
' ============================================================================
' SRSP Fitovinany — Sequence : Marquage d'une piece (Presente/Absente/Rejetee)
' ============================================================================

skinparam backgroundColor #FFFFFF

actor "Agent / Chef de Division" as Agent
participant "DepouillementChecklist.jsx" as UI
participant "API REST (port 5000)" as API
participant "depouillementService.js" as DS
participant "depouillementModel.js" as DM
database "PostgreSQL" as DB

Agent -> UI : Clique sur "Presente" / "Absente" / "Rejetee"
alt Etat non satisfait (Absente / Rejetee)
    UI -> UI : Ouvre modale de motif
    Agent -> UI : Saisit le motif et valide
end
UI -> API : POST /dossiers/:id/depouillement { piece, presente, etat, motif }
API -> API : Verifie permission (depouiller_pieces / verifier_dossier / valider_dossier)
API -> API : Verifie acces au dossier (scope)
API -> DS : enregistrer(dossierId, data, userId)
DS -> DS : Valide l'etat (ETATS_PIECE_VALIDES)
DS -> DS : Verifie motif obligatoire si etat dans ETATS_PIECE_A_MOTIVER
DS -> DM : saveDepouillement(dossierId, piece, etat, motif)
DM -> DB : INSERT/UPDATE depouillements
DM -> DB : INSERT historique_actions
DB --> DM : OK
DM --> DS : piece enregistree
DS -> DS : Recalcule le resume (complet / incomplet)
DS --> API : { resume, depouillement }
API --> UI : 200 OK
UI -> UI : Met a jour le badge et le resume
UI --> Agent : Piece marquee, resume mis a jour

@enduml

@startuml SRSP_Fitovinany_Sequence_Decision
' ============================================================================
' SRSP Fitovinany — Sequence : Decision du Chef de Division (Valider / Correction)
' ============================================================================

skinparam backgroundColor #FFFFFF

actor "Chef de Division" as Chef
participant "DossierActions.jsx" as UI
participant "API REST" as API
participant "dossierService.js" as DS
participant "depouillementService.js" as DS2
database "PostgreSQL" as DB

Chef -> UI : Ouvre le panneau "Decision"
UI -> UI : Charge le resume du depouillement (peutDecider)
UI -> API : GET /dossiers/:id/depouillement
API -> DS2 : getChecklist(dossierId)
DS2 --> API : { resume, depouillement }
API --> UI : Resume charge
UI -> UI : Affiche les pieces non satisfaites (si incomplet)
Chef -> UI : Selectionne "Valider" ou "Demander une correction"
alt Dossier incomplet et decision VALIDER
    alt Chef de Service (derogation)
        UI -> UI : Affiche le champ motif de derogation
        Chef -> UI : Saisit le motif et valide
    else Chef de Division (sans derogation)
        UI -> UI : Affiche message : "Demander une correction"
        UI -> UI : Bouton desactive (avec explication visible)
    end
end
UI -> API : POST /dossiers/:id/valider { decision, commentaire, motif_exception }
API -> DS : valider(id, data, userId)
DS -> DS : Verifie statut SOUMIS_A_VERIFICATION
DS -> DS : controlerCompletudeValidation(id, motifException, userId)
alt Dossier incomplet sans derogation
    DS --> API : 422 — Demander une correction ou un complement
    API --> UI : 422 avec message explicite
    UI --> Chef : Affiche le message d'incompletude
else Dossier complet ou derogation valide
    DS -> DS : workflowService.transition(id, VALIDE, ...)
    DS --> API : 200 OK
    API --> UI : Validation reussie
    UI --> Chef : Dossier valide
end

@enduml

@startuml SRSP_Fitovinany_Sequence_Suppression
' ============================================================================
' SRSP Fitovinany — Sequence : Suppression d'une piece jointe
' ============================================================================

skinparam backgroundColor #FFFFFF

actor "Deposant / Chef de Division" as User
participant "DocumentsPanel.jsx" as UI
participant "API REST" as API
participant "documentService.js" as DocS
database "PostgreSQL" as DB
participant "Systeme de fichiers" as FS

User -> UI : Clique sur "Supprimer" (icone corbeille)
UI -> UI : Affiche la confirmation
User -> UI : Confirme la suppression
UI -> API : DELETE /dossiers/:id/documents/:documentId
API -> API : Verifie permission (upload_document / manage_documents / verifier_dossier / valider_dossier / depouiller_pieces)
API -> API : Verifie acces au dossier (scope)
API -> DocS : supprimer(dossierId, documentId, userId)
DocS -> DB : SELECT document (findPourDossier)
DocS -> DB : Verifie statut dossier (pas ARCHIVE)
DocS -> DB : Verifie permissions (deposant ou manage_documents/verifier/valider/depouiller)
alt Non autorise
    DocS --> API : 403 — Seul le deposant, un chef de division ou un administrateur
    API --> UI : 403
else Autorise
    DocS -> FS : Supprime le fichier physique (unlinkSync)
    DocS -> DB : UPDATE documents SET remplace = NULL WHERE remplace = :id
    DocS -> DB : DELETE FROM documents WHERE id = :id
    DocS -> DB : INSERT historique_actions (SUPPRESSION_DOCUMENT)
    DB --> DocS : OK
    DocS --> API : { message: "Document supprime." }
    API --> UI : 200 OK
    UI -> UI : Recharge la liste des documents
    UI --> User : Piece supprimee
end

@enduml

